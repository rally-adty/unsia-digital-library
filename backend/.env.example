# Salin berkas ini menjadi .env lalu sesuaikan nilainya.

# Port HTTP server Express
PORT=5000

# Lingkungan aplikasi: development | production
NODE_ENV=development

# Koneksi MongoDB.
# Docker lokal (lihat docker-compose.yml di root proyek):
MONGO_URI=mongodb://unsia:unsia_secret@localhost:27017/unsia_library?authSource=admin
# MongoDB Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unsia_library?retryWrites=true&w=majority

# Kunci penandatanganan JWT. WAJIB diganti dengan nilai acak yang panjang.
JWT_SECRET=ganti-dengan-kunci-acak-yang-panjang
JWT_EXPIRES_IN=1d

# Origin frontend yang diizinkan CORS (pisahkan dengan koma bila lebih dari satu)
CORS_ORIGIN=http://localhost:5173
