{
  "info": {
    "name": "Secure UNSIA Digital Library API",
    "description": "Pengujian endpoint REST API perpustakaan digital UNSIA, mencakup skenario berhasil dan gagal. Jalankan folder '1. Autentikasi' lebih dulu karena token login disimpan otomatis ke variabel {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "token", "value": "" },
    { "key": "bookId", "value": "" },
    { "key": "memberId", "value": "" },
    { "key": "loanId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Autentikasi",
      "item": [
        {
          "name": "Register - berhasil (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Mengembalikan token', () => pm.expect(pm.response.json().data.token).to.be.a('string'));",
                  "pm.test('Password tidak ikut dikirim', () => pm.expect(pm.response.text()).to.not.include('password\\\":'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Petugas Baru\",\n  \"email\": \"petugas.baru@unsia.ac.id\",\n  \"password\": \"rahasia1\",\n  \"role\": \"petugas\"\n}"
            }
          }
        },
        {
          "name": "Register - validasi gagal (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Ada daftar error validasi', () => pm.expect(pm.response.json().errors).to.be.an('array').that.is.not.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"ab\",\n  \"email\": \"bukan-email\",\n  \"password\": \"123\"\n}"
            }
          }
        },
        {
          "name": "Register - email duplikat (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));"]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Admin Duplikat\",\n  \"email\": \"admin@unsia.ac.id\",\n  \"password\": \"rahasia1\"\n}"
            }
          }
        },
        {
          "name": "Login - berhasil (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Token diterima', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@unsia.ac.id\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "Login - password salah (401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('Pesan netral, tidak membocorkan email terdaftar', () => pm.expect(pm.response.json().message).to.eql('Email atau password salah'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@unsia.ac.id\",\n  \"password\": \"password-salah\"\n}"
            }
          }
        },
        {
          "name": "Profil saya - berhasil (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Field password tidak ada', () => pm.expect(pm.response.json().data).to.not.have.property('password'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
