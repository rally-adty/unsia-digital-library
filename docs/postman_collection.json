          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/books/{{bookId}}", "host": ["{{baseUrl}}"], "path": ["books", "{{bookId}}"] }
          }
        },
        {
          "name": "Daftar peminjaman (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Status 200 OK', () => pm.response.to.have.status(200));"]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/loans?status=dipinjam",
              "host": ["{{baseUrl}}"],
              "path": ["loans"],
              "query": [{ "key": "status", "value": "dipinjam" }]
            }
          }
        }
      ]
    },
    {
      "name": "6. Dashboard",
      "item": [
        {
          "name": "Ringkasan dashboard (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json().data;",
                  "pm.test('Kartu ringkasan lengkap', () => { pm.expect(d.cards).to.have.property('totalBooks'); pm.expect(d.cards).to.have.property('totalMembers'); pm.expect(d.cards).to.have.property('totalLoans'); pm.expect(d.cards).to.have.property('availableBooks'); });",
                  "pm.test('Data grafik tersedia', () => { pm.expect(d.charts.booksByCategory).to.be.an('array'); pm.expect(d.charts.loansPerMonth).to.have.lengthOf(6); pm.expect(d.charts.loanStatus).to.be.an('array'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/dashboard/summary", "host": ["{{baseUrl}}"], "path": ["dashboard", "summary"] }
          }
        },
        {
