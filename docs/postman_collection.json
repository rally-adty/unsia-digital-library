    {
      "name": "5. Transaksi Peminjaman",
      "item": [
        {
          "name": "Catat peminjaman - berhasil (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const due = new Date();",
                  "due.setDate(due.getDate() + 14);",
                  "pm.collectionVariables.set('dueDate', due.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const loan = pm.response.json().data;",
                  "pm.test('Status awal dipinjam', () => pm.expect(loan.status).to.eql('dipinjam'));",
                  "pm.test('Relasi buku & anggota ikut termuat', () => { pm.expect(loan.book).to.have.property('title'); pm.expect(loan.member).to.have.property('name'); });",
                  "pm.collectionVariables.set('loanId', loan._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/loans", "host": ["{{baseUrl}}"], "path": ["loans"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"book\": \"{{bookId}}\",\n  \"member\": \"{{memberId}}\",\n  \"dueDate\": \"{{dueDate}}\",\n  \"note\": \"Peminjaman uji coba\"\n}"
            }
